<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>4.0.0.0</Version>
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Features>runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GirCore.Gtk-4.0" Version="0.9.0-preview.1" />
    <!--<PackageReference Include="QuestPDF" Version="2026.9.0" />-->
    <PackageReference Include="NPOI" Version="2.8.1" />
    <PackageReference Include="SkiaSharp" Version="4.157.0" />

    <!-- Тимчасово -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccountingSoftwareLib\AccountingSoftware\AccountingSoftware.csproj" />
    <ProjectReference Include="..\AccountingSoftwareLib\InterfaceGtk4\InterfaceGtk4.csproj" />
    <ProjectReference Include="..\Configurator4\Configurator4.csproj" />
  </ItemGroup>

